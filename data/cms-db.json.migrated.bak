      "content": {
        "sections": [
          {
            "id": "sec-hero-privacy",
            "type": "hero",
            "data": {
              "eyebrow": "Zero Data Collection",
              "title": "Privacy Policy",
              "description": "Your privacy is guaranteed by technology: your text never leaves your device."
            }
          },
          {
            "id": "sec-rich-privacy",
            "type": "richText",
            "data": {
              "heading": "How Client-Side Processing Protects You",
              "content": "When you paste text, JSON, or code into any utility on this site, processing occurs strictly in your device memory. We do not operate remote databases or tracking scripts for text payloads."
            }
          }
        ]
      },
