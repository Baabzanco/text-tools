  "tools": [
    {
      "id": "tool-content-json-formatter",
      "slug": "json-formatter",
      "toolName": "JSON Formatter",
      "shortDescription": "Prettify, format, and validate raw JSON with customizable indentation.",
      "longDescription": "Prettify and format unformatted or minified JSON strings. Supports 2-space, 4-space, or tab indentation, identifies syntax errors, and calculates key statistics locally in your browser.",
      "iconIdentifier": "Code",
      "categoryLabel": "developer",
      "faq": [
        {
          "question": "Is my JSON uploaded to a server?",
          "answer": "No. JSON parsing and formatting execute 100% locally in your browser DOM. Your data remains strictly private."
        }
      ],
      "relatedTools": [
        "json-validator",
        "json-minifier",
        "jwt-decoder"
      ],
      "seoMetadata": {
        "seoTitle": "JSON Formatter – Prettify & Format JSON Online",
        "metaDescription": "Format, validate, and prettify JSON strings online with customizable 2-space, 4-space, or tab indentation.",
        "canonicalUrl": "https://texttools.app/tools/json-formatter",
        "robotsIndex": true,
        "robotsFollow": true,
        "ogTitle": "JSON Formatter – Prettify & Format JSON Online",
        "ogDescription": "Format, validate, and prettify JSON strings online with customizable 2-space, 4-space, or tab indentation.",
        "ogImage": "https://texttools.app/og-image.png",
        "twitterTitle": "JSON Formatter – Prettify & Format JSON Online",
        "twitterDescription": "Format, validate, and prettify JSON strings online with customizable 2-space, 4-space, or tab indentation.",
        "twitterImage": "https://texttools.app/og-image.png",
        "schemaJson": ""
      },
