    {
      "id": "version-id-about-v1",
      "pageId": "page-id-about",
      "versionNumber": 1,
      "content": {
        "sections": [
          {
            "id": "sec-hero-about",
            "type": "hero",
            "data": {
              "eyebrow": "Mission & Technology",
              "title": "About Text Tools",
              "description": "Text Tools is built to provide fast, reliable, privacy-first web utilities that process data exclusively in your browser."
            }
          },
          {
            "id": "sec-rich-about",
            "type": "richText",
            "data": {
              "heading": "Zero Server Transmission Philosophy",
              "content": "Unlike traditional web converters that send your confidential code, API keys, or text to remote servers, Text Tools executes 100% of processing in client-side Web Workers and JavaScript."
            }
          }
        ]
      },
      "seoMetadata": {
        "seoTitle": "About Text Tools",
        "metaDescription": "Learn about Text Tools, our client-side privacy architecture, and utility mission.",
