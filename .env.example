# Self-Hosted Production PostgreSQL Database Connection
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/texttools_cms"

# Security & Authentication Secrets (Placeholders only)
JWT_SECRET="GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_BEFORE_START"

# Media Storage Configuration
MEDIA_STORAGE_PATH="/var/www/text-tools/uploads"
MAX_UPLOAD_SIZE_MB="20"
